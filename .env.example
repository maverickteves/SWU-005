# ==============================================================================
# REAL ESTATE MANAGEMENT API - POSTGRESQL & SUPABASE CONFIGURATION
# ==============================================================================
# Application Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# OPTION 1: SUPABASE CLOUD (POSTGRESQL) - RECOMMENDED
# ------------------------------------------------------------------------------
# To connect to Supabase:
# 1. Log into https://app.supabase.com -> Open your Project
# 2. Go to Project Settings -> Database -> Connection string
# 3. Choose "URI" with "Transaction pooler" (port 6543) or "Direct" (port 5432)
# 4. Paste the connection string below (remember to replace [YOUR-PASSWORD]):
#
# DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# OR configure via Supabase Project Variables:
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
# SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
# SUPABASE_REGION=aws-0-us-east-1

# ------------------------------------------------------------------------------
# OPTION 2: LOCAL OR LAN POSTGRESQL
# ------------------------------------------------------------------------------
DATABASE_TYPE=postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=real_estate
DATABASE_USER=postgres
DATABASE_PASSWORD=

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# Security & Access Control
# ------------------------------------------------------------------------------
# Normal users/clients interact via REST API and never see database credentials.
# Administrative endpoints (e.g. /admin/db-status) require this admin header:
ADMIN_API_KEY=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
